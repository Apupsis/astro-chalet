---
// Base layout: the HTML skeleton shared by every page.
import "../styles/global.css";
import { SITE } from "../config/site";
import Seo from "../components/Seo.astro";
import JsonLdLocalBusiness from "../components/JsonLdLocalBusiness.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** true on pages that must not be indexed (legal, 404) */
  noindex?: boolean;
  /** The JSON-LD LocalBusiness markup is only useful on the home page */
  withJsonLd?: boolean;
}

const { title, description, noindex = false, withJsonLd = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} noindex={noindex} />
    {withJsonLd && <JsonLdLocalBusiness />}
  </head>
  <body>
    <a href="#content" class="skip-link">{SITE.ui.skipToContent}</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
