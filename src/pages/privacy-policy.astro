---
// Privacy policy (GDPR).
// This template covers the simple case of a brochure site with NO tracking
// cookies: no cookie banner is required as long as you don't add third-party
// analytics or iframes (embedded Google Maps, YouTube...). If the site needs
// analytics, prefer a cookieless solution (Plausible, Vercel Analytics) to
// keep this page honest and avoid the banner.
// ADAPT the prose to your jurisdiction and to what the site actually does.
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const { business, ui } = SITE;
---

<Base
  title={`${ui.privacyPolicyLabel} — ${SITE.name}`}
  description={`Privacy policy for ${SITE.name}.`}
  noindex
>
  <div class="container page-content">
    <h1>{ui.privacyPolicyLabel}</h1>

    <h2>Data we collect</h2>
    <p>
      This site sets no tracking cookies and uses no audience-measurement tool
      that tracks visitors. The only personal data collected is what you send
      us voluntarily through the contact form (name, email address, message
      content).
    </p>

    <h2>How the data is used</h2>
    <p>
      Information sent through the contact form is used solely to answer your
      request. It is never sold, shared with third parties, or used for
      marketing without your consent.
    </p>

    <h2>Retention period</h2>
    <p>
      Messages are kept for the time needed to handle your request, and for a
      maximum of 12 months for business follow-up purposes.
    </p>

    <h2>Your rights</h2>
    <p>
      Under the General Data Protection Regulation (GDPR), you have the right
      to access, rectify and delete the data that concerns you. To exercise
      these rights, write to
      <a href={`mailto:${business.email}`}>{business.email}</a>.
      You may also lodge a complaint with your national data protection
      authority.
    </p>

    <h2>External links</h2>
    <p>
      Buttons linking to Google Maps and to our social profiles lead to
      third-party sites that apply their own privacy policies. No data is sent
      to them until you click those links.
    </p>
  </div>
</Base>
