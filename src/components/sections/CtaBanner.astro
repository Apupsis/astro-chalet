---
// Call-to-action banner: a dark break in the page with one clear proposition
// (quote, booking, order...) and a warm glow rising from the bottom.
import { SITE } from "../../config/site";

const { ctaBanner } = SITE;
---

<section class="banner">
  <div class="container banner-inner">
    <div>
      <h2 class="banner-title">{ctaBanner.title}</h2>
      <p class="banner-text">{ctaBanner.text}</p>
    </div>
    <a class="button" href={ctaBanner.button.href}>{ctaBanner.button.label}</a>
  </div>
</section>

<style>
  .banner {
    position: relative;
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding-block: calc(var(--space-4) * 1.4);
    overflow: hidden;
    isolation: isolate;
  }

  .banner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 130% at 50% 118%, rgba(194, 95, 8, 0.42) 0%, transparent 68%),
      var(--color-dark-bg);
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .banner-title {
    color: var(--color-dark-text);
    margin-bottom: var(--space-1);
  }

  .banner-text {
    margin: 0;
    color: var(--color-dark-text-muted);
  }

  .banner .button {
    white-space: nowrap;
  }
</style>
