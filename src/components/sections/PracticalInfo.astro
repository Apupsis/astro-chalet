---
// Practical info section: opening hours + address + map link.
// The map is a link to Google Maps rather than an embedded iframe:
// no third-party cookies on page load = simple GDPR story and a fast page.
import { SITE } from "../../config/site";

const { openingHours, business, ui } = SITE;

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${SITE.name} ${business.address.street} ${business.address.city}`
)}`;
---

<section id="info" class="section section-alt">
  <div class="container">
    {ui.infoEyebrow && <p class="section-eyebrow">{ui.infoEyebrow}</p>}
    <h2>{ui.infoTitle}</h2>
    <div class="grid-2">
      <div class="card">
        <h3>{ui.hoursTitle}</h3>
        <table class="hours-table">
          <tbody>
            {
              openingHours.map((h) => (
                <tr>
                  <th scope="row">{h.label}</th>
                  <td>{h.closed ? ui.closedLabel : `${h.opens} – ${h.closes}`}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="card">
        <h3>{ui.findUsTitle}</h3>
        <p>
          {business.address.street}<br />
          {business.address.postalCode} {business.address.city}
        </p>
        <p>
          <a href={`tel:${business.phone}`}>{business.phone}</a>
        </p>
        <p class="info-actions">
          <a class="button" href={directionsUrl} target="_blank" rel="noopener noreferrer">
            {ui.directionsLabel}
          </a>
          <a
            class="button button-secondary"
            href={business.googleBusinessUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui.googleProfileLabel}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .hours-table th {
    text-align: left;
    font-weight: 600;
    padding: 0.4rem 0;
  }

  .hours-table td {
    text-align: right;
    color: var(--color-text-muted);
  }

  .hours-table tr + tr {
    border-top: 1px solid var(--color-border);
  }

  .info-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
</style>
