---
// Customer reviews: social proof — the single most persuasive element on a
// local business site. A big aggregate score (computed from the items) sits
// next to the title; each card gets a serif quote mark and an avatar chip.
// Reviews are copied from the business's Google profile (with a link to all
// reviews, for transparency). Stars are inline SVGs with a text alternative.
import { SITE } from "../../config/site";

const { reviews, ui } = SITE;

const STAR_PATH =
  "M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4L2.6 9.4l6.5-.9z";

// Aggregate rating computed at build time from the configured reviews
const average =
  reviews.items.reduce((sum, item) => sum + item.rating, 0) / reviews.items.length;
const averageLabel = (Math.round(average * 10) / 10).toFixed(1);
const averageRounded = Math.round(average);
---

<section id="reviews" class="section section-alt">
  <div class="container">
    <div class="reviews-header">
      <div>
        {reviews.eyebrow && <p class="section-eyebrow">{reviews.eyebrow}</p>}
        <h2 class="reviews-title">{reviews.title}</h2>
      </div>
      <p class="reviews-score" aria-label={`${ui.ratingLabel} ${averageLabel} ${ui.ratingOutOf}`}>
        <span class="reviews-score-number" aria-hidden="true">{averageLabel}</span>
        <span class="reviews-score-stars" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill={n <= averageRounded ? "currentColor" : "none"}
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d={STAR_PATH} />
            </svg>
          ))}
        </span>
        <span class="reviews-score-label">{ui.reviewsScoreLabel}</span>
      </p>
    </div>
    <div class="grid-3">
      {
        reviews.items.map((item) => (
          <figure class="card review-card reveal">
            <span class="review-quote" aria-hidden="true">“</span>
            <p class="review-stars" aria-label={`${ui.ratingLabel} ${item.rating} ${ui.ratingOutOf}`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill={n <= item.rating ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </p>
            <blockquote class="review-text">{item.text}</blockquote>
            <figcaption class="review-author">
              <span class="review-avatar" aria-hidden="true">
                {item.author.trim().charAt(0).toUpperCase()}
              </span>
              {item.author}
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="review-link">
      <a href={reviews.allReviewsUrl} target="_blank" rel="noopener noreferrer">
        {ui.readAllReviews}
      </a>
    </p>
  </div>
</section>

<style>
  .reviews-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .reviews-title {
    margin-bottom: 0;
  }

  .reviews-score {
    text-align: right;
    margin: 0;
  }

  .reviews-score-number {
    font-family: var(--font-heading);
    font-size: 3.4rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    display: block;
  }

  .reviews-score-stars {
    color: var(--color-rating);
    display: inline-flex;
    gap: 2px;
    margin-top: 6px;
  }

  .reviews-score-label {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: 4px;
  }

  .review-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
  }

  .review-quote {
    position: absolute;
    top: 0.6rem;
    left: var(--space-3);
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-surface-alt);
    user-select: none;
  }

  .review-stars {
    color: var(--color-rating);
    display: flex;
    gap: 3px;
    margin-bottom: var(--space-1);
    position: relative;
  }

  .review-text {
    margin: 0 0 var(--space-2);
    font-style: italic;
    color: var(--color-text);
    font-size: var(--text-sm);
    flex: 1;
    position: relative;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .review-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--gradient-icon);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex: none;
  }

  .review-link {
    margin-top: var(--space-3);
  }
</style>
