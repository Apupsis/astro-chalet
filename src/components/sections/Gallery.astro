---
// Gallery section: asymmetric grid — the first image is featured (2×2),
// the rest tile around it. Lazy loading, gentle hover zoom with a warm
// bottom gradient (both disabled under prefers-reduced-motion / touch).
// Tip: 5 or 7 images fill the desktop grid perfectly.
import { SITE } from "../../config/site";

const { gallery } = SITE;
---

<section id="gallery" class="section">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    <div class="gallery-grid">
      {
        gallery.images.map((image) => (
          <figure class="gallery-item reveal">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              width="400"
              height="300"
              class="gallery-image"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 210px;
    gap: var(--space-2);
  }

  /* Featured first image */
  .gallery-item:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden; /* clips the zoomed image */
    position: relative;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  /* Warm gradient sweeping up from the bottom on hover */
  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 62%, rgba(29, 20, 13, 0.5) 100%);
    opacity: 0;
    transition: opacity var(--transition);
  }

  @media (hover: hover) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.05);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }
  }

  @media (max-width: 820px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:hover .gallery-image {
      transform: none;
    }
  }
</style>
