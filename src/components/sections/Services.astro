---
// Services/products section: a card grid driven by SITE.services.
// Icons are real inline SVGs in a gradient chip (see Icon.astro) — never
// emoji. Each card carries a serif index number that lights up on hover.
import { SITE } from "../../config/site";
import Icon from "../Icon.astro";

const { services } = SITE;
---

<section id="services" class="section">
  <div class="container">
    {services.eyebrow && <p class="section-eyebrow">{services.eyebrow}</p>}
    <h2>{services.title}</h2>
    <p class="intro">{services.intro}</p>
    <div class="grid-3">
      {
        services.items.map((item, index) => (
          <article class="card service-card reveal">
            <span class="service-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="service-icon">
              <Icon name={item.icon} size={30} />
            </p>
            <h3>{item.title}</h3>
            <p class="service-description">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .service-icon {
    color: #fff;
    background: var(--gradient-icon);
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-2);
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.3);
  }

  .service-index {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-border);
    transition: color var(--transition);
  }

  @media (hover: hover) {
    .card:hover .service-index {
      color: var(--color-accent-bright);
    }
  }

  .service-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
