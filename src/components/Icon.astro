---
// Inline SVG icon set — no emoji, no icon-font download, inherits currentColor.
// Lucide-inspired stroke style (24×24 grid, rounded caps).
// Add a business-specific icon: add an entry to PATHS below, then use its key
// in SITE.services.items[].icon. Unknown keys fall back to "sparkles".
interface Props {
  /** Icon key (see PATHS below) */
  name: string;
  /** Rendered size in px */
  size?: number;
}

const { name, size = 28 } = Astro.props;

const PATHS: Record<string, string> = {
  bread: `<path d="M4 13a8 5 0 0 1 16 0v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M9 11v4"/><path d="M12 10v5"/><path d="M15 11v4"/>`,
  croissant: `<path d="M19 15a8 8 0 1 1-10-10 6.5 6.5 0 0 0 10 10z"/><path d="M14.5 17.5 13 19"/><path d="M17.5 14.5 19 13"/>`,
  cake: `<path d="M5 19v-5a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v5"/><path d="M3 19h18"/><path d="M5.5 15.5c1.2 1 2.3 1 3.5 0s2.3-1 3.5 0 2.3 1 3.5 0 1.7-.8 2.5-.3"/><path d="M12 13v-3"/><circle cx="12" cy="7.5" r="1"/>`,
  sandwich: `<rect x="3" y="6.5" width="18" height="4" rx="2"/><rect x="3" y="13.5" width="18" height="4" rx="2"/>`,
  coffee: `<path d="M17 9h1a3.5 3.5 0 1 1 0 7h-1"/><path d="M3 9h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M7 5V3.5"/><path d="M11 5V3.5"/>`,
  utensils: `<path d="M3 2v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3z"/><path d="M21 15v7"/>`,
  bed: `<path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M2 17h20"/><path d="M6 10V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/>`,
  mountain: `<path d="m8 3 4 8 5-5 5 15H2L8 3z"/>`,
  wrench: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  sparkles: `<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>`,
};

const inner = PATHS[name] ?? PATHS.sparkles;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
