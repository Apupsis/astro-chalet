---
// Sticky dark header with a subtle blur: business name + navigation.
// On mobile the menu opens via a burger button (the tiny script at the
// bottom is the ONLY JavaScript on the whole site — maximum performance).
import { SITE } from "../config/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{SITE.name}</a>

    <button
      id="menu-burger"
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label={SITE.ui.menuOpenLabel}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-menu" class="nav">
      {SITE.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-dark-bg) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(247, 240, 228, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 70px;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-dark-text);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .brand:hover {
    color: var(--color-accent-bright);
  }

  .nav {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--color-dark-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: color var(--transition);
  }

  .nav a:hover {
    color: var(--color-accent-bright);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: var(--space-1);
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2.5px;
    background: var(--color-dark-text);
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-dark-bg);
      border-bottom: 1px solid rgba(247, 240, 228, 0.12);
    }

    .nav.open {
      display: flex;
    }

    .nav a {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid rgba(247, 240, 228, 0.12);
    }
  }
</style>

<script>
  // Mobile menu: ~10 lines of JS — the entire JavaScript budget of the site.
  const burger = document.getElementById("menu-burger");
  const menu = document.getElementById("main-menu");

  burger?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(Boolean(open)));
  });

  // Close the menu when a link is clicked (anchor navigation)
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      menu.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>
