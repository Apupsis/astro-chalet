---
// schema.org "LocalBusiness" structured data — THE component that moves the
// needle in local SEO. Google uses it for the business panel in search
// results (hours, phone, reviews...). Everything is generated from
// SITE.business and SITE.openingHours: no data to maintain twice.
// Validate with: https://search.google.com/test/rich-results
import { SITE } from "../config/site";

// schema.org names days in English
const SCHEMA_DAYS = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday",
];

// Turn the site's opening hours into OpeningHoursSpecification entries,
// skipping closing days.
const hoursSchema = SITE.openingHours
  .filter((h) => !h.closed && h.opens && h.closes)
  .map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days.map((d) => SCHEMA_DAYS[d]),
    opens: h.opens,
    closes: h.closes,
  }));

const data = {
  "@context": "https://schema.org",
  "@type": SITE.business.schemaType,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.business.phone,
  email: SITE.business.email,
  image: new URL(SITE.hero.image, SITE.url).href,
  priceRange: SITE.business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.business.address.street,
    postalCode: SITE.business.address.postalCode,
    addressLocality: SITE.business.address.city,
    addressCountry: SITE.business.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.business.geo.latitude,
    longitude: SITE.business.geo.longitude,
  },
  openingHoursSpecification: hoursSchema,
  sameAs: [...SITE.business.socialProfiles, SITE.business.googleBusinessUrl],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
