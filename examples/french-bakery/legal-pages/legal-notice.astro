---
// Mentions légales — obligatoires pour tout site professionnel français
// (LCEN, art. 6-III). Générées depuis SITE.legal : vérifier que chaque champ
// de la config est exact. Remplace src/pages/legal-notice.astro par ce fichier.
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const { legal, business, ui } = SITE;
---

<Base
  title={`${ui.legalNoticeLabel} — ${SITE.name}`}
  description={`Mentions légales du site ${SITE.name}.`}
  noindex
>
  <div class="container page-content">
    <h1>{ui.legalNoticeLabel}</h1>

    <h2>Éditeur du site</h2>
    <p>
      {SITE.name}, {legal.companyType}<br />
      {business.address.street}, {business.address.postalCode}
      {business.address.city}<br />
      SIRET : {legal.registrationNumber}<br />
      Téléphone : <a href={`tel:${business.phone}`}>{business.phone}</a><br />
      Email : <a href={`mailto:${business.email}`}>{business.email}</a>
    </p>

    <h2>Directeur de la publication</h2>
    <p>{legal.publisher}</p>

    <h2>Hébergement</h2>
    <p>
      {legal.host.name}<br />
      {legal.host.address}<br />
      <a href={legal.host.url} target="_blank" rel="noopener noreferrer">
        {legal.host.url}
      </a>
    </p>

    <h2>Propriété intellectuelle</h2>
    <p>
      L'ensemble des contenus de ce site (textes, images, logo) est la propriété
      exclusive de {SITE.name}, sauf mention contraire. Toute reproduction, même
      partielle, est soumise à autorisation préalable.
    </p>
  </div>
</Base>
