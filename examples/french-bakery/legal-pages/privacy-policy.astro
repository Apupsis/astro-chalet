---
// Politique de confidentialité (RGPD) — version française.
// Ce modèle correspond au cas simple d'un site vitrine SANS cookies de suivi :
// pas de bannière cookies nécessaire tant qu'on n'ajoute pas d'analytics tiers
// ou d'iframe (Google Maps embarqué, YouTube...). Si le client veut des
// analytics, préférer une solution sans cookies pour garder cette page honnête.
// Remplace src/pages/privacy-policy.astro par ce fichier.
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const { business, ui } = SITE;
---

<Base
  title={`${ui.privacyPolicyLabel} — ${SITE.name}`}
  description={`Politique de confidentialité du site ${SITE.name}.`}
  noindex
>
  <div class="container page-content">
    <h1>{ui.privacyPolicyLabel}</h1>

    <h2>Données collectées</h2>
    <p>
      Ce site ne dépose aucun cookie de suivi et n'utilise aucun outil de mesure
      d'audience traçant les visiteurs. Les seules données personnelles collectées
      sont celles que vous transmettez volontairement via le formulaire de contact
      (nom, adresse email, contenu du message).
    </p>

    <h2>Utilisation des données</h2>
    <p>
      Les informations envoyées via le formulaire de contact servent uniquement à
      répondre à votre demande. Elles ne sont ni revendues, ni transmises à des
      tiers, ni utilisées à des fins de prospection sans votre accord.
    </p>

    <h2>Durée de conservation</h2>
    <p>
      Les messages reçus sont conservés le temps du traitement de la demande, puis
      au maximum 12 mois à des fins de suivi de la relation commerciale.
    </p>

    <h2>Vos droits</h2>
    <p>
      Conformément au Règlement général sur la protection des données (RGPD), vous
      disposez d'un droit d'accès, de rectification et de suppression des données
      vous concernant. Pour l'exercer, écrivez-nous à
      <a href={`mailto:${business.email}`}>{business.email}</a>.
      Vous pouvez également introduire une réclamation auprès de la CNIL
      (<a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer">cnil.fr</a>).
    </p>

    <h2>Liens externes</h2>
    <p>
      Les boutons vers Google Maps et nos réseaux sociaux mènent vers des sites
      tiers qui appliquent leurs propres politiques de confidentialité. Aucune
      donnée ne leur est transmise tant que vous ne cliquez pas sur ces liens.
    </p>
  </div>
</Base>
